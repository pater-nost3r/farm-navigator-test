# NASA POWER and the geocoder need no key. Kept only for other official NASA APIs; never sent or logged.
NASA_API_KEY=your_nasa_api_key

# Optional settings
# NASA_TIMEOUT_SECONDS=15       # one POWER attempt
# NASA_RETRIES=2                # retries with backoff, inside NASA_DEADLINE_SECONDS
# NASA_DEADLINE_SECONDS=24
# CACHE_TTL_SECONDS=2592000     # 30 days; expired copies are still used if POWER fails
# CACHE_DIR=.cache/nasa_power   # empty = memory cache only; /tmp/... on Vercel
# CORS_ORIGINS=http://localhost:3000,http://localhost:4321,http://localhost:5173
